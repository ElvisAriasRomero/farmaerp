{
  "expo": {
    "name": "FarmaERP",
    "slug": "farmaerp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "farmaerp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmaerp.mobile"
    },
    "android": {
      "package": "com.farmaerp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3864"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear códigos de barras de productos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F3864"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://farmaerp-api.onrender.com/api/v1",
      "apiUrlWeb": "https://farmaerp-api.onrender.com/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ea999b7d-273e-472c-a1a2-d5c221ec8abe"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
