# ============================================================
# Variables de entorno para PRODUCCIÓN (Render).
# En Render NO subes este archivo: las variables se definen en
# el dashboard o se inyectan automáticamente vía render.yaml.
# Este archivo es solo de referencia.
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=genera-una-clave-larga-y-aleatoria

# Hosts: Render setea RENDER_EXTERNAL_HOSTNAME automáticamente.
# Puedes añadir dominios extra separados por coma.
ALLOWED_HOSTS=

# Orígenes del frontend (https) permitidos por CORS y CSRF.
CORS_ALLOWED_ORIGINS=https://farmaerp-web.onrender.com
CSRF_TRUSTED_ORIGINS=https://farmaerp-web.onrender.com

# PostgreSQL (Render los inyecta desde la base de datos del blueprint).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_prediccion
DB_USER=farmaerp
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Redis / Celery (Render lo inyecta desde el servicio redis).
CELERY_BROKER_URL=redis://...
CELERY_RESULT_BACKEND=redis://...
